# ---------------------------------------------------------------
# Build Artifacts
# Compiled object files, static/dynamic libraries, and executables
# generated during the CMake / Make build process.
# ---------------------------------------------------------------
build/
*.o
*.obj
*.a
*.lib
*.exe
*.out
test_runner
gen_tpch

# ---------------------------------------------------------------
# Engine Output
# Runtime files produced by NanoDB: binary table files and logs.
# These are generated on every run and should not be versioned.
# ---------------------------------------------------------------
*.ndb
*.log
nanodb_execution.log

# ---------------------------------------------------------------
# Generated TPC-H Data
# Raw benchmark data tables produced by the TPC-H data generator.
# Excluded because they are large and reproducible on demand.
# ---------------------------------------------------------------
data/*.tbl

# ---------------------------------------------------------------
# IDE & Editor Files
# Local workspace settings and OS metadata that are
# developer-specific and not part of the project source.
# ---------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store

# ---------------------------------------------------------------
# CMake Cache & Intermediate Files
# Auto-generated by CMake during configuration; safe to delete
# and regenerate at any time.
# ---------------------------------------------------------------
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile.cmake

# ---------------------------------------------------------------
# Profiler Output
# Output files from Valgrind (callgrind, massif) and GCC coverage
# instrumentation. Generated locally during profiling sessions.
# ---------------------------------------------------------------
callgrind.*
massif.*
*.gcda
*.gcno
