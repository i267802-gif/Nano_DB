# ---------------------------------------------------------------
# Claude Code Configuration
# Local AI assistant settings, session memory, and workspace
# configs generated by Claude Code CLI. Never commit these.
# ---------------------------------------------------------------
.claude/

# ---------------------------------------------------------------
# Build Artifacts
# Compiled binaries, object files, and libraries produced
# during the build process.
# ---------------------------------------------------------------
build/
*.o
*.obj
*.a
*.lib
*.exe
*.out

# ---------------------------------------------------------------
# IDE & Editor Files
# Developer-specific workspace settings and OS metadata.
# ---------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---------------------------------------------------------------
# Environment & Secrets
# Local environment files that may contain sensitive credentials.
# ---------------------------------------------------------------
.env
.env.local
*.secret

# ---------------------------------------------------------------
# Logs & Temp Files
# Runtime-generated output that should not be versioned.
# ---------------------------------------------------------------
*.log
*.tmp
*.cache
